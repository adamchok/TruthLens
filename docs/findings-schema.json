{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://truthlens.ibm.com/schemas/findings-v1.json",
  "title": "TruthLens Findings Report",
  "description": "Schema for TruthLens claim violation findings output",
  "type": "object",
  "required": [
    "version",
    "generatedAt",
    "repository",
    "summary",
    "findings"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "examples": [
        "1.0.0"
      ]
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of when the audit was performed"
    },
    "repository": {
      "type": "object",
      "required": [
        "root",
        "commit"
      ],
      "properties": {
        "root": {
          "type": "string",
          "description": "Absolute path to repository root"
        },
        "commit": {
          "type": "string",
          "description": "Git commit hash (or 'unknown' if not a git repo)"
        },
        "branch": {
          "type": "string",
          "description": "Current git branch"
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "bySeverity",
        "byCategory"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0,
          "description": "Total number of findings"
        },
        "bySeverity": {
          "type": "object",
          "required": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "properties": {
            "critical": {
              "type": "integer",
              "minimum": 0
            },
            "high": {
              "type": "integer",
              "minimum": 0
            },
            "medium": {
              "type": "integer",
              "minimum": 0
            },
            "low": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "byCategory": {
          "type": "object",
          "required": [
            "CAT-A",
            "CAT-B",
            "CAT-C",
            "CAT-D"
          ],
          "properties": {
            "CAT-A": {
              "type": "integer",
              "minimum": 0
            },
            "CAT-B": {
              "type": "integer",
              "minimum": 0
            },
            "CAT-C": {
              "type": "integer",
              "minimum": 0
            },
            "CAT-D": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "description": "Array of individual claim violation findings",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "confidence",
          "file",
          "line",
          "claim",
          "reality",
          "blastRadius",
          "suggestedFix",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F-\\d{3}$",
            "description": "Unique finding identifier (e.g., F-001)",
            "examples": [
              "F-001",
              "F-042"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "CAT-A",
              "CAT-B",
              "CAT-C",
              "CAT-D"
            ],
            "description": "Claim violation category"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ],
            "description": "Impact severity of the violation"
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence score (0.0-1.0) that this is a true violation"
          },
          "file": {
            "type": "string",
            "description": "Workspace-relative file path"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "Starting line number (1-indexed)"
          },
          "endLine": {
            "type": "integer",
            "minimum": 1,
            "description": "Ending line number (optional, for multi-line violations)"
          },
          "claim": {
            "type": "object",
            "required": [
              "text",
              "source",
              "extractedFrom"
            ],
            "properties": {
              "text": {
                "type": "string",
                "description": "The verbatim claim text"
              },
              "source": {
                "type": "string",
                "enum": [
                  "function_name",
                  "docstring",
                  "test_name",
                  "comment",
                  "documentation"
                ],
                "description": "Where the claim was found"
              },
              "extractedFrom": {
                "type": "string",
                "description": "The artifact name (e.g., function name, test name)"
              }
            }
          },
          "reality": {
            "type": "object",
            "required": [
              "description",
              "evidence"
            ],
            "properties": {
              "description": {
                "type": "string",
                "description": "What the code actually does"
              },
              "evidence": {
                "type": "array",
                "description": "Code snippets or facts proving the reality",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "blastRadius": {
            "type": "object",
            "required": [
              "callerCount",
              "affectedFiles"
            ],
            "properties": {
              "callerCount": {
                "type": "integer",
                "minimum": 0,
                "description": "Number of call sites affected"
              },
              "affectedFiles": {
                "type": "array",
                "description": "List of files that reference this artifact",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "suggestedFix": {
            "type": "object",
            "required": [
              "strategy",
              "summary"
            ],
            "properties": {
              "strategy": {
                "type": "string",
                "enum": [
                  "rename_artifact",
                  "fix_implementation",
                  "update_documentation",
                  "add_validation"
                ],
                "description": "Recommended fix approach"
              },
              "summary": {
                "type": "string",
                "description": "Human-readable fix description"
              },
              "estimatedEffort": {
                "type": "string",
                "enum": [
                  "trivial",
                  "small",
                  "medium",
                  "large"
                ],
                "description": "Estimated effort to fix"
              }
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "dismissed"
            ],
            "description": "Current status of the finding"
          },
          "resolvedAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the finding was resolved (if status=resolved)"
          },
          "resolvedBy": {
            "type": "string",
            "description": "How the finding was resolved (if status=resolved)"
          }
        }
      }
    }
  }
}